{
  "extends": "eslint-config-standard-universal/tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "skipLibCheck": true,
    "allowJs": false,
    "checkJs": false,
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "./*.ts"
  ]
}
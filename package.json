{
  "name": "hayase-lite",
  "version": "0.1.3",
  "private": true,
  "description": "Hayase-lite - Personal torrent streaming app",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "concurrently \"pnpm --filter ./interface-master dev\" \"pnpm --filter ./electron-main dev\"",
    "dev:ui": "pnpm --filter ./interface-master dev",
    "build": "pnpm --filter ./interface-master build && pnpm --filter ./electron-main build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm --filter ./native-main build && pnpm --filter ./torrent-client-main build && pnpm --filter ./electron-main typecheck",
    "clean": "pnpm -r exec rm -rf dist out .output .svelte-kit build node_modules"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "electron": "42.2.0"
  }
}
